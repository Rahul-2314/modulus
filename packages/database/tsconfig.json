{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,

    "verbatimModuleSyntax": true
  },
  "include": [
    "index.ts",
    "generated/**/*.ts"
  ]
}