// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// membership role
enum MembershipRole {
  owner
  admin
  member
}

// user schema
model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String        @map("password_hash")
  createdAt       DateTime      @default(now()) @map("created_at")
  memberships     Membership[]

  @@map("users")
}

// organization schema
model Organization {
  id            String        @id @default(uuid())
  name          String
  createdAt     DateTime      @default(now()) @map("created_at")
  memberships   Membership[]
  projects      Project[]

  @@map("organizations")
}

// membership details schema
model Membership {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  organizationId  String          @map("organization_id")
  role            MembershipRole  @default(member)
  createdAt       DateTime        @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// project schema
model Project {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  name              String
  environment       String          @default("development")
  createdAt         DateTime        @default(now()) @map("created_at")

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents            Agent[]
  apiKeys           ApiKey[]

  @@map("projects")
}

// api key schema
model ApiKey {
  id          String      @id @default(uuid())
  projectId   String      @map("project_id")
  keyHash     String      @map("key_hash")
  prefix      String
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// agent schema
model Agent {
  id                String      @id @default(uuid())
  projectId         String      @map("project_id")
  name              String
  framework         String?
  adapterVersion    String?     @map("adapter_version")
  createdAt         DateTime    @default(now()) @map("created_at")

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions         Execution[]

  @@unique([projectId, name])
  @@map("agents")
}

// execution state
enum ExecutionStatus {
  running
  succeeded
  failed
}

// execution state schema (id - OTel trace id)
model Execution {
  id          String      @id
  agentId     String      @map("agent_id")
  status      ExecutionStatus   @default(running)
  startedAt   DateTime    @map("started_at")
  endedAt     DateTime?   @map("ended_at")
  input       Json?
  output      Json?
  cost        Decimal?        @db.Decimal(10, 4) @map("cost")
  createdAt   DateTime    @default(now()) @map("created_at")

  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events      ExecutionEvent[]
  toolCalls   ToolCall[]

  @@index([agentId, startedAt])
  @@map("executions")
}

// exec event schema (type - type of events(start, end, error, call etc.))
model ExecutionEvent {
  id            String    @id @default(uuid())
  executionId   String    @map("execution_id")
  type          String
  timestamp     DateTime
  payload       Json

  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
  @@map("execution_events")
}

enum ToolCallStatus {
  success
  error
}

// tool calling state schema
model ToolCall {
  id            String      @id @default(uuid())
  executionId   String      @map("execution_id")
  toolName      String      @map("tool_name")
  arguments     Json
  response      Json?
  status        ToolCallStatus
  latency       Int         @map("latency")
  createdAt     DateTime    @default(now()) @map("created_at")

  execution     Execution   @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("tool_calls")
}
