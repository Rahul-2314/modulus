# CENTRALIZED ENVIRONMENT CONFIGURATION
# Copy this file to .env at the repository root. Never commit the real .env file.

# DIRECTORY: packages/database
# Used by Prisma and by the API when connecting to PostgreSQL from your host machine.
DATABASE_URL=postgresql://postgres:modulus@localhost:5432/modulus?schema=public

# DIRECTORY: infra/docker
# Used by services exposed through docker-compose.yml.
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# DIRECTORY: apps/api
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000

# DIRECTORY: apps/web
# Next.js forwards /api/* to this address.
API_URL=http://localhost:5000
