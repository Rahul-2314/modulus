# CENTRALIZED ENVIRONMENT CONFIGURATION
# Copy this file to .env at the repository root. Never commit the real .env file.

# DIRECTORY: packages/database
# Used by Prisma and by the API when connecting to PostgreSQL from your host machine.
DATABASE_URL=postgresql://postgres:modulus@localhost:5432/modulus?schema=public

# DIRECTORY: infra/docker
# Used by services exposed through docker-compose.yml.
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# DIRECTORY: apps/api
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000

# DIRECTORY: apps/web
# Next.js forwards /api/* to this address.
API_URL=http://localhost:5000

# DIRECTORY: packages/crypto
ENCRYPTION_KEY=base64-encoded-32-byte-key

# DIRECTORY: packages/llm
GROQ_API_KEY=replace-with-groq-api-key
DIAGNOSIS_MODEL=llama-3.3-70b-versatile

# DIRECTORY: packages/github
GITHUB_TOKEN=replace-with-github-token

# DIRECTORY: packages/sandbox
MODULUS_SANDBOX_IMAGE=node:24-slim

# DIRECTORY: tests
# A real project API key is required for authenticated ingestion tests.
TEST_API_KEY=replace-with-test-api-key
