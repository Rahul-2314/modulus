# ============================================================
# MODULUS - ENVIRONMENT CONFIGURATION
# ============================================================
#
# Copy this file to .env at the repository root:
#   cp .env.example .env
#
# Never commit the real .env file.
# Never put production secrets in this file.
# ============================================================


# ============================================================
# DATABASE
# packages/database
# ============================================================

DATABASE_URL=


# ============================================================
# INFRASTRUCTURE
# infra/docker
# ============================================================

REDIS_URL=
QDRANT_URL=


# ============================================================
# LLM
# packages/llm
# ============================================================

GROQ_API_KEY=
GEMINI_API_KEY=

# Primary model used for diagnosis.
# Example:
# DIAGNOSIS_MODEL=llama-3.3-70b-versatile
DIAGNOSIS_MODEL=


# ============================================================
# SANDBOX
# workers/reproducer
# workers/fixer
# ============================================================

# Docker image used for isolated reproduction/execution.
# Example:
# MODULUS_SANDBOX_IMAGE=node:24-slim
MODULUS_SANDBOX_IMAGE=


# ============================================================
# GITHUB INTEGRATION
# packages/github
# workers/reproducer
# workers/fixer
# ============================================================

# Legacy/fallback GitHub token, if supported by the application.
GITHUB_TOKEN=

# Repository in owner/repository format.
# Example:
# REPO=Rahul-2314/modulus
REPO=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=


# ============================================================
# EMAIL
# packages/email
# Resend
# ============================================================

RESEND_API_KEY=
EMAIL_FROM=


# ============================================================
# OPERATIONS / ALERTING
# packages/notifications
# ============================================================

OPS_SLACK_WEBHOOK_URL=
OPS_PAGERDUTY_KEY=
OPS_ALERT_EMAIL=


# ============================================================
# WEB APPLICATION
# apps/web
# ============================================================

# GitHub App slug used by the frontend.
NEXT_PUBLIC_GITHUB_APP_SLUG=

# Internal server-to-server API URL.
INTERNAL_API_URL=

# Public API URL used by the web application.
API_URL=


# ============================================================
# API SERVER
# apps/api
# ============================================================

NODE_ENV=development
PORT=5000


# ============================================================
# BETTER AUTH
# apps/api
# ============================================================

BETTER_AUTH_SECRET=

# Base URL of the API.
API_BASE_URL=

# Base URL of the web application.
WEB_APP_URL=


# ============================================================
# GOOGLE OAUTH
# Better Auth
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=